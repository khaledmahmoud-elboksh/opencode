{
    "$schema":  "https://opencode.ai/config.json",
    "model":  "opencode-go/kimi-k2.7-code",
    "small_model":  "opencode-go/claude-haiku-5-5",
    "default_agent":  "build",
    "agent":  {
                  "planner":  {
                                  "model":  "opencode-go/grok-4.7"
                              },
                  "architect":  {
                                    "model":  "opencode-go/grok-4.7"
                                }
              },
    "plugins":  [
                    "opencode-gemini-auth",
                    "opencode-froggy",
                    "opencode-agent-memory"
                ],
    "mcp":  {
                "context7":  {
                                 "type":  "remote",
                                 "url":  "https://mcp.context7.com/mcp",
                                 "enabled":  true
                             },
                "playwright":  {
                                   "type":  "local",
                                   "command":  [
                                                   "npx",
                                                   "-y",
                                                   "@playwright/mcp"
                                               ],
                                   "enabled":  true
                               },
                "sequential-thinking":  {
                                            "type":  "local",
                                            "command":  [
                                                            "npx",
                                                            "-y",
                                                            "@modelcontextprotocol/server-sequential-thinking"
                                                        ],
                                            "enabled":  true
                                        },
                "github":  {
                               "type":  "local",
                               "command":  [
                                               "npx",
                                               "-y",
                                               "@modelcontextprotocol/server-github"
                                           ],
                               "enabled":  true,
                               "env":  {
                                           "GITHUB_PERSONAL_ACCESS_TOKEN":  "{env:GITHUB_TOKEN}"
                                       }
                           },
                "chrome-devtools":  {
                                        "type":  "local",
                                        "command":  [
                                                        "npx",
                                                        "-y",
                                                        "chrome-devtools-mcp@latest"
                                                    ],
                                        "enabled":  true
                                    },
                "ecc-memory-vault":  {
                                         "type":  "local",
                                         "command":  [
                                                         "node", "C:\\Users\\PC\\.config\\opencode\\mcp-memory-vault.mjs"
                                                     ],
                                         "enabled":  true,
                                         "environment":  {
                                                             "ECC_MEMORY_HARNESS":  "opencode",
                                                             "ECC_MEMORY_ALLOW_USER_SCOPE":  "1"
                                                         }
                                     }
            }
}
